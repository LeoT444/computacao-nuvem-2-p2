# Public OAuth client ID for Google Identity Services.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=placeholder;AccountKey=placeholder;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=destination-container
WEB_API_TOKEN=replace-with-a-long-random-secret
